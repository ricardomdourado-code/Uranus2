OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Nome do número WhatsApp (para logs)
WA_OWNER_NAME=Ricardo Dourado
# Sincronizar histórico completo ao parear/reconectar (true/false)
WA_SYNC_FULL_HISTORY=true
# Timezone
TZ=America/Bahia
# Hora inicial da primeira leitura profunda (0-23)
DEEP_READ_HOUR=8
# Intervalo em horas para leituras subsequentes
READ_INTERVAL_HOURS=3
# Máximo de mensagens por conversa para enviar ao GPT
MAX_MESSAGES_PER_CHAT=50
# Salvar relatórios em arquivo
SAVE_REPORTS=true
REPORTS_DIR=./reports
